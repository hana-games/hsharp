---
import "@fontsource/instrument-serif/latin-400.css";
import "@fontsource/instrument-serif/latin-400-italic.css";
import "@fontsource/inter/latin-400.css";
import "@fontsource/inter/latin-500.css";
import "@fontsource/inter/latin-600.css";
import "@fontsource/jetbrains-mono/latin-400.css";
import "@fontsource/jetbrains-mono/latin-500.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  active?: string;
  canonical?: string;
}

const { title, description, active = "", canonical } = Astro.props;
const fullTitle = title === "h#" ? "h# — One core. Your syntax. Six native outputs." : `${title} — h#`;

const siteURL = Astro.site ?? new URL("https://hsharp.dev");
const rawPath = Astro.url.pathname;
const isNotFound = rawPath.includes("404");
const pathname = isNotFound
  ? "/404.html"
  : rawPath === "/"
    ? "/"
    : `${rawPath.replace(/\/+$/, "")}/`;
const canonicalUrl = canonical ?? new URL(pathname, siteURL).href;
const localizedUrl = (locale: "en" | "fr" | "ja") =>
  locale === "en"
    ? canonicalUrl
    : new URL(`/${locale}${pathname === "/" ? "/" : pathname}`, siteURL).href;
const englishUrl = localizedUrl("en");
const frenchUrl = localizedUrl("fr");
const japaneseUrl = localizedUrl("ja");
const ogLocale = "en_US";
const robots = isNotFound ? "noindex, follow" : "index, follow, max-image-preview:large";

const organizationId = `${siteURL.origin}/#organization`;
const websiteId = `${siteURL.origin}/#website`;
const softwareId = `${siteURL.origin}/#software`;
const siteDescription = "One semantic core. Personal syntax. Six verified native outputs.";
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": organizationId,
      name: "HANAGAMES.net",
      url: "https://hanagames.net",
      sameAs: ["https://github.com/hana-games/hsharp"],
    },
    {
      "@type": "WebSite",
      "@id": websiteId,
      url: `${siteURL.origin}/`,
      name: "h#",
      description: siteDescription,
      inLanguage: "en",
      publisher: { "@id": organizationId },
    },
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: fullTitle,
      description,
      inLanguage: "en",
      isPartOf: { "@id": websiteId },
      about: { "@id": softwareId },
    },
    {
      "@type": "SoftwareSourceCode",
      "@id": softwareId,
      name: "h#",
      description: siteDescription,
      inLanguage: "en",
      codeRepository: "https://github.com/hana-games/hsharp",
      programmingLanguage: "h#",
      version: "0.1.0",
      url: `${siteURL.origin}/`,
      author: { "@id": organizationId },
      publisher: { "@id": organizationId },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="author" content="HANAGAMES.net" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0a0c10" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="h#" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} data-seo-url />
    <meta property="og:locale" content={ogLocale} data-seo-og-locale />
    <meta property="og:locale:alternate" content="fr_FR" />
    <meta property="og:locale:alternate" content="ja_JP" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="canonical" href={canonicalUrl} data-seo-canonical />
    <link rel="alternate" hreflang="en" href={englishUrl} />
    <link rel="alternate" hreflang="fr" href={frenchUrl} />
    <link rel="alternate" hreflang="ja" href={japaneseUrl} />
    <link rel="alternate" hreflang="x-default" href={englishUrl} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="alternate" type="text/plain" hreflang="en" href="/llms.txt" title="llms.txt" />
    <link rel="alternate" type="text/plain" hreflang="fr" href="/fr/llms.txt" title="llms.txt" />
    <link rel="alternate" type="text/plain" hreflang="ja" href="/ja/llms.txt" title="llms.txt" />
    <script type="application/ld+json" data-seo-jsonld set:html={JSON.stringify(structuredData)}></script>
  </head>
  <body>
    <a class="sr-only" href="#main">Skip to content</a>
    <Header active={active} />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Copy buttons for static code blocks.
      document.addEventListener("click", async (event) => {        const target = event.target as HTMLElement | null;
        const button = target?.closest("[data-copy]") as HTMLButtonElement | null;
        if (!button) return;
        const text = button.dataset.copy ?? "";
        try {
          await navigator.clipboard.writeText(text);
          const previous = button.textContent;
          button.textContent = "Copied";
          window.setTimeout(() => {
            if (button.textContent === "Copied") button.textContent = previous ?? "Copy";
          }, 1400);
        } catch {
          // Clipboard can be denied; leave the label unchanged.
        }
      });

      // Close the mobile navigation after a link is chosen.
      document.querySelectorAll(".mobile-nav-panel a").forEach((link) => {
        link.addEventListener("click", () => {
          const details = link.closest("details");
          if (details) details.removeAttribute("open");
        });
      });

      // Subtle reveal on scroll.
      const items = document.querySelectorAll(".reveal");
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches && "IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
        );
        items.forEach((item) => observer.observe(item));
      } else {
        items.forEach((item) => item.classList.add("is-visible"));
      }
    </script>
    <script is:inline src="/i18n/localize.js"></script>
  </body>
</html>
