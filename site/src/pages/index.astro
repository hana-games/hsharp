---
import BaseLayout from "../layouts/BaseLayout.astro";
import { HeroEditor } from "../components/HeroEditor";
import { ProfileComposer } from "../components/ProfileComposer";
import { TargetPrism } from "../components/TargetPrism";
import ExampleSnippet from "../components/ExampleSnippet.astro";
import { siteData } from "../data/data";
import { profiles, site, targets } from "../lib/site";

const featured = ["demo-bonus-true", "function-call", "overflow-add-max"]
  .map((id) => siteData.examples.find((example) => example.id === id))
  .filter((example): example is NonNullable<typeof example> => Boolean(example));

function prettyId(id: string) {
  return id.split("-").map((part) => part[0].toUpperCase() + part.slice(1)).join(" ");
}
---

<BaseLayout
  title="h#"
  description="A universal semantic core, personal syntax, and verified native output for C#, Rust, Go, Java, C++, and JavaScript."
  active="/"
>
  <section class="hero">
    <div class="container">
      <div class="hero-inner">
        <div class="hero-copy">
          <div class="row" style="gap:0.55rem;">
            <div class="eyebrow" data-i18n-skip style="text-transform:none;letter-spacing:0.06em;">Portable Language Core</div>
            <span class="version-pill">v{site.version}</span>
          </div>
          <h1 class="display">
            A universal core.<br />
            <em>Your own syntax.</em><br />
            Six native outputs.
          </h1>
          <p class="lede">
            h# separates meaning from notation. Shape the language to your own vocabulary, keep one
            checked semantic core, and generate real C#, Rust, Go, Java, C++, and JavaScript projects.
          </p>
          <div class="hero-actions">
            <a class="btn btn-lime" href="/why">Explore the language</a>
            <a class="btn btn-ghost" href="/playground">Open the playground</a>
          </div>
        </div>

        <HeroEditor client:load demo={siteData.demo} />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <h2 class="h2">A language is a semantic promise.</h2>
        </div>
        <p class="lede">
          h# is not six translators pretending to agree. It is one specification, one typed AST, and
          a conformance suite that runs every case through every profile and every target.
        </p>
      </div>

      <div class="universality-graph reveal">
        <div class="graph-col">
          <div class="graph-label">Notation</div>
          <div class="graph-profile-stack">
            {profiles.map((profile) => <span class="graph-pill">{profile.label}</span>)}
            <span class="graph-pill dashed">your profile</span>
          </div>
          <p class="graph-note">7 keyword roles · validated data</p>
        </div>

        <div class="graph-flow" aria-hidden="true">
          <span>↔</span>
          <small>export / reimport</small>
        </div>

        <div class="graph-core">
          <div class="graph-core-kicker">one contract</div>
          <div class="graph-core-mark">h#</div>
          <h3>Semantic core</h3>
          <p>Typed AST · checker · checked i32 · failure nodes</p>
        </div>

        <div class="graph-flow" aria-hidden="true">
          <span>→</span>
          <small>emit</small>
        </div>

        <div class="graph-col">
          <div class="graph-label">Targets</div>
          <div class="graph-targets">
            {
              targets.map((target) => (
                <div class="graph-target" data-target={target.id}>
                  <div class="graph-target-top">
                    <span class="graph-target-logo">
                      <img src={target.logo} alt={`${target.label} logo`} width="16" height="16" />
                    </span>
                    <span class="graph-target-name">{target.label}</span>
                    <span class="graph-target-check">verified</span>
                  </div>
                  <small>{target.command}</small>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <div class="direction-grid reveal">
        <div class="direction-card both">
          <h3>Canonical source ↔ personal notation</h3>
          <p>
            Export and reimport share the same normalized AST. Fingerprints protect both ends; comments
            and identifiers survive the round trip.
          </p>
        </div>
        <div class="direction-card oneway">
          <h3>h# → generated targets</h3>
          <p>
            Target source is generated output, not a second source of truth. C#, Rust, Go, Java, C++, and JavaScript are
            compiled and executed, never parsed back as canonical source.
          </p>
        </div>
        <div class="direction-card future">
          <h3>Generated targets → h# import</h3>
          <p>
            Reverse import is out of scope. Target source is output, not a second canonical notation;
            importing it would require a separate frontend, type inference, and library semantics.
          </p>
        </div>
      </div>

      <div class="stat-band" style="margin-top:2rem;">
        <div class="stat-band-item"><strong>{siteData.meta.stats.cases}</strong><span>conformance cases</span></div>
        <div class="stat-band-item"><strong>{siteData.meta.stats.profiles}</strong><span>syntax profiles</span></div>
        <div class="stat-band-item"><strong>{siteData.meta.stats.targets}</strong><span>native targets</span></div>
        <div class="stat-band-item"><strong>{siteData.meta.stats.executions}</strong><span>target executions</span></div>
      </div>
    </div>
  </section>

  <section class="section band-dark">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <h2 class="h2">Rename the surface.<br /><em class="italic lime">Keep the program.</em></h2>
        </div>
        <p class="lede">
          A profile is a small, validated JSON document. Start from the supplied standard notation or
          build your own. The preview below is composed in the browser; no h# code is executed.
        </p>
      </div>

      <ProfileComposer client:visible />
    </div>
  </section>

  <section class="section band-paper-2">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <h2 class="h2">One typed AST.<br />Six native dialects.</h2>
        </div>
        <p class="lede">
          Each backend emits ordinary source for its ecosystem. The differences are explicit and
          inspectable; the meaning is shared. Switch targets and open any generated file.
        </p>
      </div>
      <TargetPrism client:visible demo={siteData.demo} />
      <div class="row" style="margin-top:1rem;">
        <a class="btn btn-ghost" href="/why#boundary">Explore the boundary lab</a>
        <a class="btn btn-ghost" href="/playground#workflow">Try the collaboration workflow</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <h2 class="h2">Proof,<br />not promises.</h2>
        </div>
        <p class="lede">
          The site is not the oracle. The repository is. These numbers come from actual compilations
          and executions across every profile and target.
        </p>
      </div>

      <div class="proof-strip reveal">
        <div class="proof-item"><strong>{siteData.conformance.summary.cases}</strong><span>cases</span></div>
        <div class="proof-item"><strong>{siteData.conformance.summary.targets}</strong><span>target executions</span></div>
        <div class="proof-item"><strong>{siteData.conformance.summary.failed}</strong><span>failed</span></div>
        <div class="proof-item"><strong>{siteData.conformance.summary.blocked}</strong><span>blocked</span></div>
      </div>

      <div class="row" style="margin-top:1.5rem;">
        <a class="btn btn-solid" href="/docs/verification">Read the verification evidence</a>
        <a class="btn btn-ghost" href="/why">Why this matters</a>
      </div>
    </div>
  </section>

  <section class="section band-paper-2">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <h2 class="h2">Small programs.<br />Real guarantees.</h2>
        </div>
        <p class="lede">
          Every example is part of the conformance corpus: functions, calls, conditions, precedence,
          overflow boundaries, short-circuit evaluation, and profile conversion.
        </p>
      </div>

      <div class="grid grid-3">
        {
          featured.map((example) => (
            <a class="example-card reveal" href={`/examples?example=${example.id}`}>
              <div class="example-meta">
                <span>{example.feature}</span>
                <span class={example.expected.status === "error" ? "error-text" : "success-text"}>
                  {example.expected.status === "ok"
                    ? `ok · ${example.expected.type} ${String(example.expected.value)}`
                    : `error · ${example.expected.code}`}
                </span>
              </div>
              <h3>{prettyId(example.id)}</h3>
              <p>{example.notes || `Entry: ${example.entry ?? "inferred"}`}</p>
              <div class="example-code-wrap">
                <div class="example-code-head">
                  <span>{example.program.replace("programs/", "")}</span>
                  <span>standard</span>
                </div>
                <ExampleSnippet code={example.profiles.standard.code} keywords={siteData.demo.sources.standard.keywords} />
                <span class="example-open">Open example <span>→</span></span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container cta-inner">
      <div>
        <h2 class="display" style="font-size:clamp(2.8rem,6vw,5.4rem);">
          Make the next<br /><em class="italic">translation</em> unnecessary.
        </h2>
      </div>
      <div class="cta-actions">
        <a class="btn btn-solid" href="/docs/getting-started">Read the docs</a>
        <a class="btn btn-ghost" href="/playground">Try the playground</a>
      </div>
    </div>
  </section>
</BaseLayout>
