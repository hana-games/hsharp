---
import BaseLayout from "../layouts/BaseLayout.astro";
import StaticCode from "../components/StaticCode.astro";
import { BoundaryLab } from "../components/BoundaryLab";
import { siteData } from "../data/data";
import { targets } from "../lib/site";

const standard = siteData.demo.sources.standard;
const personal = siteData.demo.sources["my-syntax"];

const surfaceChanges = [
  { from: "fn", to: "function" },
  { from: "let", to: "value" },
  { from: "if", to: "when" },
  { from: "else", to: "otherwise" },
  { from: "return", to: "give" },
  { from: "true", to: "yes" },
  { from: "false", to: "no" },
];

const invariants = [
  { title: "Typed AST", note: "Same structure" },
  { title: "Evaluation order", note: "Same left-to-right order" },
  { title: "Overflow behavior", note: "Same failure nodes" },
  { title: "Generated targets", note: "Same four backend projects" },
  { title: "Identifiers", note: "Program names are untouched" },
];

const driftBehaviors: Record<string, string> = {
  csharp: "unchecked int addition",
  rust: "debug panic / release wrap",
  go: "int32 wraps",
  java: "int wraps",
};

const driftStatus: Record<string, string> = {
  csharp: "silent wrap",
  rust: "panic / wrap",
  go: "silent wrap",
  java: "silent wrap",
};
---

<BaseLayout
  title="Why h#"
  description="Portability as a checked engineering property: one semantic core, a bounded portable feature set, personal notation, and four independently verified outputs."
  active="/why"
>
  <section class="band-dark why-hero">
    <div class="container">
      <div class="why-hero-grid">
        <div class="why-hero-copy">
          <h1 class="display">
            Portability should be <em class="italic lime">provable.</em>
          </h1>
          <p class="lede">
            The same edge case can wrap, panic, or disappear depending on the toolchain. h# makes the
            contract explicit before anything is generated.
          </p>
          <div class="row">
            <a class="btn btn-solid" href="/docs/verification">See what is verified</a>
            <a class="btn btn-ghost" href="#boundary">Explore the boundary</a>
          </div>
        </div>

        <div class="drift-panel">
          <div class="drift-panel-head">
            <div>
              <span class="drift-kicker">Same operation</span>
              <code>return x + 1;</code>
            </div>
            <span class="drift-input">x = 2147483647</span>
          </div>
          <div class="drift-rows">
            {
              targets.map((target) => (
                <div class="drift-row" data-target={target.id}>
                  <span class="drift-target">
                    <img src={target.logo} alt={`${target.label} logo`} width="14" height="14" />
                    {target.label}
                  </span>
                  <span class="drift-behavior">{driftBehaviors[target.id]}</span>
                  <span class="drift-status">{driftStatus[target.id]}</span>
                </div>
              ))
            }
            <div class="drift-row reference">
              <span class="drift-target">h#</span>
              <span class="drift-behavior">E_OVERFLOW · node 11</span>
              <span class="drift-status">checked</span>
            </div>
          </div>
          <div class="drift-foot">
            h# checks the range before emitting. Native defaults never become the contract.
          </div>
        </div>
      </div>

      <div class="why-hero-proof">
        <div><strong>{targets.length}</strong><span>native outputs</span></div>
        <div><strong>{siteData.meta.stats.profiles}</strong><span>syntax profiles</span></div>
        <div><strong>{siteData.meta.stats.executions}</strong><span>verified executions</span></div>
        <div><strong>{siteData.conformance.summary.failed}</strong><span>known divergences</span></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <h2 class="h2">Portability is usually a promise.<br /><em class="italic">Drift is the reality.</em></h2>
        </div>
        <p class="lede">
          Teams rewrite the same business rule for C#, Rust, Go, and Java. The syntax is different,
          but so are overflow behavior, evaluation order, error propagation, naming rules, and edge
          cases. The divergences appear later, in production.
        </p>
      </div>

      <div class="thesis">
        <div class="thesis-sticky">
          <div class="card card-lime">
            <h3 class="h2" style="font-size:clamp(1.8rem,3.4vw,2.8rem);">
              Specify once.<br />Generate four times.<br />Verify every time.
            </h3>
          </div>
        </div>
        <div class="thesis-list">
          <div class="thesis-item">
            <div class="num">01</div>
            <div>
              <h3 class="h3">One semantic core</h3>
              <p>
                Types, precedence, evaluation order, checked arithmetic, and failure codes are
                normative. They do not belong to a backend.
              </p>
            </div>
          </div>
          <div class="thesis-item">
            <div class="num">02</div>
            <div>
              <h3 class="h3">A bounded portable feature set</h3>
              <p>
                The compatible subset is explicit. A feature is portable only when it passes on every
                advertised target. Target-specific extensions remain separate.
              </p>
            </div>
          </div>
          <div class="thesis-item">
            <div class="num">03</div>
            <div>
              <h3 class="h3">Notation is not semantics</h3>
              <p>
                A profile changes seven keyword roles. It cannot introduce hidden behavior. The
                normalized AST is identical across profiles.
              </p>
            </div>
          </div>
          <div class="thesis-item">
            <div class="num">04</div>
            <div>
              <h3 class="h3">Evidence is executable</h3>
              <p>
                Expected values are written independently, then every target is compiled and run.
                A missing compiler is blocked, not green.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section band-paper-2" id="boundary">
    <div class="container">
      <div class="section-head">
        <div>
          <h2 class="h2">Universality needs<br />a boundary.</h2>
        </div>
        <p class="lede">
          A language that claims everything cannot verify anything. h# starts with a small core:
          enough to express real functions and checked arithmetic, small enough to specify completely.
        </p>
      </div>

      <div class="boundary-board reveal">
        <div class="boundary-col core">
          <span class="boundary-tag">Portable core</span>
          <h3>Checked by contract</h3>
          <p>
            Small enough to specify exhaustively. Rich enough to express real functions and failure
            behavior without a hidden runtime.
          </p>
          <div class="boundary-chips">
            <span>i32</span>
            <span>bool</span>
            <span>checked + − *</span>
            <span>short-circuit</span>
            <span>acyclic calls</span>
          </div>
          <ul class="boundary-list">
            <li>immutable typed locals</li>
            <li>functions and checked calls</li>
            <li>if / else and returns</li>
            <li>comparisons and Boolean logic</li>
            <li>short-circuit evaluation</li>
          </ul>
        </div>

        <div class="boundary-col outside">
          <span class="boundary-tag">Outside</span>
          <h3>No hidden portability</h3>
          <p>
            Features that cannot be specified and verified across all four targets stay out of the
            core. They are extension work, not accidental behavior.
          </p>
          <ul class="boundary-list">
            <li>strings, lists, records</li>
            <li>loops and recursion</li>
            <li>mutation and shared memory</li>
            <li>modules and generics</li>
            <li>I/O and async</li>
            <li>target-specific libraries</li>
            <li>macros and grammar modules</li>
            <li>continuous personalized editing</li>
          </ul>
        </div>

        <div class="boundary-col gate">
          <span class="boundary-tag">Acceptance gate</span>
          <h3>How a feature enters</h3>
          <p>Every gate is required. A green result on one target cannot compensate for a blocked one.</p>
          <ol class="gate-steps">
            <li><span>01</span>Written semantics</li>
            <li><span>02</span>Expected examples</li>
            <li><span>03</span>Typed AST</li>
            <li><span>04</span>Four translations</li>
            <li><span>05</span>All targets pass</li>
          </ol>
          <p class="boundary-note">
            Each future feature must earn its place: a written semantics, expected examples, typed
            representation, four translations, and acceptance on every target. The roadmap makes that
            dependency explicit.
          </p>
        </div>
      </div>

      <div class="boundary-try reveal">
        <div class="boundary-try-head">
          <div>
            <h3>Try the boundary.</h3>
            <p>Change an operand and inspect the exact failure node. No h# code runs in the browser.</p>
          </div>
          <span class="chip">client-side · precomputed</span>
        </div>
        <BoundaryLab client:visible />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <h2 class="h2">Different surface.<br />Same structure.</h2>
        </div>
        <p class="lede">
          Conversion rewrites keyword tokens only. The normalized AST ignores locations, comments,
          and profile words, so the structure is identical before and after export.
        </p>
      </div>

      <div class="equivalence-grid">
        <div class="reveal">
          <StaticCode code={standard.code} language="hsharp" keywords={standard.keywords} title="calculate.hs" meta="standard" />
        </div>
        <div class="reveal">
          <StaticCode code={personal.code} language="hsharp" keywords={personal.keywords} title="calculate.personal.hs" meta="my-syntax" />
        </div>
      </div>

      <div class="equivalence-badge reveal" style="margin-top:1rem;">
        <strong>Normalized AST equality</strong>
        <span>profile-independent · comments preserved separately</span>
      </div>

      <div class="semantic-diff reveal">
        <div class="semantic-diff-pane changes-pane">
          <div class="semantic-diff-head">
            <span class="semantic-diff-icon">Aa</span>
            <div>
              <div class="eyebrow">What changes</div>
              <p>Surface tokens in <code>my-syntax</code></p>
            </div>
            <span class="semantic-diff-count">7 roles</span>
          </div>

          <div class="change-grid">
            {
              surfaceChanges.map((change) => (
                <div class="change-chip">
                  <code data-i18n-skip>{change.from}</code>
                  <span class="change-arrow">→</span>
                  <code data-i18n-skip class="change-to">{change.to}</code>
                </div>
              ))
            }
          </div>

          <p class="semantic-diff-foot">
            Only keyword tokens. Operators, types, braces, and semicolons stay fixed.
          </p>
        </div>

        <div class="semantic-diff-divider" aria-hidden="true">
          <span>=</span>
          <small>same core</small>
        </div>

        <div class="semantic-diff-pane invariants-pane">
          <div class="semantic-diff-head">
            <span class="semantic-diff-icon check">✓</span>
            <div>
              <div class="eyebrow">What does not</div>
              <p>Semantic contract</p>
            </div>
            <span class="semantic-diff-count zero">0 changes</span>
          </div>

          <ul class="invariant-list">
            {
              invariants.map((invariant) => (
                <li>
                  <span class="invariant-check">✓</span>
                  <span>
                    <strong>{invariant.title}</strong>
                    <small>{invariant.note}</small>
                  </span>
                </li>
              ))
            }
          </ul>

          <p class="semantic-diff-foot">
            Comments are preserved separately. Source locations are not compared.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section band-dark">
    <div class="container">
      <div class="section-head">
        <div>
          <h2 class="h2">One core for people.<br /><em class="italic lime">One contract for machines.</em></h2>
        </div>
        <p class="lede">
          Different languages are useful to humans. They are expensive for tools. A model or an agent
          should not need to learn every target grammar before it can reason about one program.
        </p>
      </div>

      <div class="machine-grid">
        <div class="machine-card">
          <span class="machine-tag">Human interface</span>
          <h3>Notation is a choice</h3>
          <p>Profiles let each person keep a familiar vocabulary without changing the program.</p>
        </div>
        <div class="machine-card">
          <span class="machine-tag">Machine interface</span>
          <h3>One checked surface</h3>
          <p>
            A typed AST, stable diagnostics, and one outcome protocol give tools a single contract to
            read and edit.
          </p>
        </div>
        <div class="machine-card">
          <span class="machine-tag">Execution</span>
          <h3>Targets stay native</h3>
          <p>
            C#, Rust, Go, and Java remain real build targets. The shared contract sits before
            translation, not instead of it.
          </p>
        </div>
      </div>

      <p class="machine-note">
        The POC does not ship an AI product. The architecture simply removes the need to model every
        surface syntax before a tool can act on the program.
      </p>
    </div>
  </section>

  <section class="section band-paper-2">
    <div class="container">
      <div class="section-head">
        <div>
          <h2 class="h2">The proof is executable.</h2>
        </div>
        <p class="lede">
          Every advertised number comes from a compile and a run. Missing toolchains block the suite;
          they never turn into optimistic green.
        </p>
      </div>

      <div class="proof-strip reveal">
        <div class="proof-item"><strong>{siteData.conformance.summary.cases}</strong><span>cases</span></div>
        <div class="proof-item"><strong>{siteData.conformance.summary.targets}</strong><span>target executions</span></div>
        <div class="proof-item"><strong>{siteData.conformance.summary.failed}</strong><span>failed</span></div>
        <div class="proof-item"><strong>{siteData.conformance.summary.blocked}</strong><span>blocked</span></div>
      </div>

      <div class="grid grid-3" style="margin-top:2rem;">
        <div class="card reveal">
          <h3 class="h3">Stable expectations</h3>
          <p class="small" style="margin-top:0.6rem;">
            Values and error codes are specified independently of the compiler and pinned in the
            corpus. Overflow failures also pin their source node.
          </p>
        </div>
        <div class="card reveal">
          <h3 class="h3">Four profiles</h3>
          <p class="small" style="margin-top:0.6rem;">
            Standard, my-syntax, terse, and casual are all parsed, checked, compared, and executed.
            A cosmetic profile never buys a semantic shortcut.
          </p>
        </div>
        <div class="card reveal">
          <h3 class="h3">Blocked is not pass</h3>
          <p class="small" style="margin-top:0.6rem;">
            A missing or too-old toolchain marks the target blocked and makes the suite exit non-zero.
            There is no optimistic green.
          </p>
        </div>
      </div>

      <div class="row" style="margin-top:1.5rem;">
        <a class="btn btn-solid" href="/docs/verification">Read the verification evidence</a>
        <a class="btn btn-ghost" href="/examples">Browse real examples</a>
      </div>
    </div>
  </section>

  <section class="section band-lime">
    <div class="container">
      <div class="section-head" style="margin-bottom:0;">
        <div>
          <h2 class="display" style="font-size:clamp(2.6rem,5.5vw,5rem);">
            A shared semantic core<br />is more useful than a<br /><em class="italic">shared syntax.</em>
          </h2>
        </div>
        <div>
          <p class="lede" style="color:var(--ink); max-width:42ch;">
            Syntax is personal. Semantics must be shared. Targets are real. Those three statements
            define the project.
          </p>
          <div class="cta-actions" style="margin-top:1.2rem;">
            <a class="btn btn-solid" href="/docs/getting-started">Get started</a>
            <a class="btn btn-ghost" href="/roadmap">Read the roadmap</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
