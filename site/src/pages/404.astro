---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Not found"
  description="This page does not exist in the h# site."
  active=""
>
  <section class="section">
    <div class="container">
      <div class="eyebrow">404</div>
      <h1 class="display" style="margin-top:0.8rem;">Nothing here.<br /><em class="italic">Still portable.</em></h1>
      <p class="lede" style="margin-top:1.2rem;">
        The page you requested does not exist. The language, the documentation, and the playground are
        still one click away.
      </p>
      <div class="row" style="margin-top:1.4rem;">
        <a class="btn btn-solid" href="/">Back to overview</a>
        <a class="btn btn-ghost" href="/docs">Read the docs</a>
      </div>
    </div>
  </section>
</BaseLayout>
