---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ExampleGallery } from "../components/ExampleGallery";
import { siteData } from "../data/data";
---

<BaseLayout
  title="Examples"
  description="Real h# programs from the conformance corpus, with standard and personal notation, expected outcomes, and six verified targets."
  active="/examples"
>
  <section class="section-tight" style="padding-top:2.4rem;">
    <div class="container">
      <ExampleGallery client:load examples={siteData.examples} />
    </div>
  </section>

  <section class="cta-band">
    <div class="container cta-inner">
      <div>
        <h2 class="display" style="font-size:clamp(2.4rem,5vw,4.6rem);">
          Compose syntax.<br /><em class="italic">Inspect the boundaries.</em>
        </h2>
      </div>
      <div class="cta-actions">
        <a class="btn btn-solid" href="/playground">Open the playground</a>
        <a class="btn btn-ghost" href="/docs/language">Read the semantics</a>
      </div>
    </div>
  </section>
</BaseLayout>
