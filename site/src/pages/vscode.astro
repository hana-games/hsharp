---
import BaseLayout from "../layouts/BaseLayout.astro";
import StaticCode from "../components/StaticCode.astro";
import { siteData } from "../data/data";
import { site } from "../lib/site";

const source = siteData.demo.sources.standard.code;
const generated =
  siteData.demo.targets.csharp.files.find((file) => file.path === "Program.cs")?.content ?? "";
const preview = generated.split("\n").slice(0, 16).join("\n");

const install = `npm install
npm run vscode:install`;
const manual = `npm run vscode:package
code --install-extension build/vscode/hsharp-vscode.vsix --force`;
const develop = `npm run vscode:build
# then open editors/vscode and press F5`;
const repo = "https://github.com/hana-games/hsharp/tree/main/editors/vscode";
---

<BaseLayout
  title="VS Code"
  description="Profile-aware highlighting, live diagnostics, and a real-time generated-code preview for C#, Rust, Go, and Java inside Visual Studio Code."
  active="/vscode"
>
  <section class="vscode-hero">
    <div class="container">
      <div class="vscode-hero-grid">
        <div>
          <div class="row" style="gap:0.55rem;">
            <span class="chip chip-lime">Visual Studio Code</span>
            <span class="version-pill">v{site.version}</span>
          </div>
          <h1 class="h1" style="margin-top:1rem; max-width:14ch;">
            h# in your <em class="italic">editor.</em>
          </h1>
          <p class="lede" style="margin-top:1.1rem;">
            Profile-aware highlighting, compiler diagnostics, and a live preview of all four targets.
            The compiler runs inside the extension host; no external hs process is needed.
          </p>
          <div class="row" style="margin-top:1.4rem;">
            <a class="btn btn-lime" href="#install">Install the extension</a>
            <a class="btn btn-ghost" href={repo}>Extension source</a>
          </div>
        </div>

        <div class="vscode-window" aria-label="Mock Visual Studio Code window with h# diagnostics and generated C# preview">
          <div class="vscode-titlebar">
            <div class="vscode-dots" aria-hidden="true"><span></span><span></span><span></span></div>
            <span>h# — calculate.hs — Visual Studio Code</span>
            <span class="vscode-window-status">preview</span>
          </div>
          <div class="vscode-body">
            <div class="vscode-sidebar" aria-hidden="true">
              <div class="vscode-sidebar-title">Explorer</div>
              <div class="vscode-tree">
                <span>⌄ examples</span>
                <strong>calculate.hs</strong>
                <span>profiles</span>
                <span>build</span>
              </div>
              <div class="vscode-sidebar-title" style="margin-top:1rem;">Problems</div>
              <div class="vscode-problem-ok">● No diagnostics</div>
            </div>
            <div class="vscode-main">
              <div class="vscode-tabs">
                <span class="vscode-tab active">calculate.hs</span>
                <span class="vscode-tab">Preview: Program.cs</span>
              </div>
              <div class="vscode-panes">
                <div class="vscode-pane">
                  <div class="vscode-pane-label">h# · standard <span>entry: calculate</span></div>
                  <StaticCode code={source} language="hsharp" keywords={siteData.demo.sources.standard.keywords} />
                </div>
                <div class="vscode-pane">
                  <div class="vscode-pane-label">generated · C# <span>read-only</span></div>
                  <StaticCode code={preview} language="csharp" />
                </div>
              </div>
              <div class="vscode-problemsbar">
                <span class="vscode-ok">● No problems</span>
                <span>AST matched</span>
                <span>4 targets ready</span>
              </div>
            </div>
          </div>
          <div class="vscode-statusbar">
            <span>h# {site.version}</span>
            <span>main · 3 functions</span>
            <span>C# preview</span>
            <span>2.4 ms</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <h2 class="h2">One editor.<br />The whole language.</h2>
        </div>
        <p class="lede">
          The extension is a thin, fast surface over the same compiler used by the CLI. It keeps
          notation personal while making the semantic core visible.
        </p>
      </div>

      <div class="vscode-features">
        <div class="vscode-feature">
          <span class="vscode-feature-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 9l-3 3 3 3" /><path d="M16 9l3 3-3 3" /></svg>
          </span>
          <h3>Profile-aware highlighting</h3>
          <p>Keywords follow the active profile JSON. Types, numbers, operators, and comments keep their colors.</p>
        </div>
        <div class="vscode-feature">
          <span class="vscode-feature-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 7v6M12 17h.01" /></svg>
          </span>
          <h3>Live diagnostics</h3>
          <p>The same compiler as the CLI reports syntax, type, return, and recursion errors with source locations.</p>
        </div>
        <div class="vscode-feature">
          <span class="vscode-feature-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12z" /><circle cx="12" cy="12" r="2.5" /></svg>
          </span>
          <h3>Real-time preview</h3>
          <p>Open the generated-code panel beside the editor and switch between C#, Rust, Go, and Java.</p>
        </div>
        <div class="vscode-feature">
          <span class="vscode-feature-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3z" /><path d="M4 7.5l8 4.5 8-4.5M12 12v9" /></svg>
          </span>
          <h3>Bundled compiler</h3>
          <p>The extension host imports the analyzer directly. No Node process, hs command, or bridge is required.</p>
        </div>
        <div class="vscode-feature">
          <span class="vscode-feature-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M3 8h18M8 8v12" /></svg>
          </span>
          <h3>Editor integration</h3>
          <p>Status bar, editor-title action, snippets, and settings for profile, entry function, debounce, diagnostics, and default target.</p>
        </div>
        <div class="vscode-feature">
          <span class="vscode-feature-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h7l2 2h9v10H3z" /></svg>
          </span>
          <h3>Workspace profiles</h3>
          <p>Relative profile paths resolve against the first workspace folder, so teams can share a notation.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section band-paper-2" id="install">
    <div class="container">
      <div class="section-head">
        <div>
          <h2 class="h2">Install once.<br />Keep your notation.</h2>
        </div>
        <p class="lede">
          The extension is a desktop workspace extension. It is not a web extension, and it does not
          need the CLI at runtime.
        </p>
      </div>

      <div class="vscode-install-grid">
        <div>
          <h3 class="h3">From the repository</h3>
          <p class="small" style="margin-top:0.4rem;">Build the bundled extension and install the generated VSIX.</p>
          <StaticCode code={install} language="bash" title="terminal" meta="package + install" />
        </div>
        <div>
          <h3 class="h3">Manual install</h3>
          <p class="small" style="margin-top:0.4rem;">Package the VSIX, then install it with the VS Code CLI.</p>
          <StaticCode code={manual} language="bash" title="terminal" meta="VSIX" />
        </div>
      </div>

      <div class="vscode-develop">
        <div>
          <h3 class="h3">Develop the extension</h3>
          <p class="small" style="margin-top:0.4rem;">
            Build once, open the extension folder, and use the h# Extension launch configuration.
          </p>
        </div>
        <StaticCode code={develop} language="bash" title="terminal" meta="F5" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <h2 class="h2">Command palette.<br />No ceremony.</h2>
        </div>
        <p class="lede">
          One command opens the preview. The rest is configuration: choose a profile, an entry
          function, a target, and the refresh delay you prefer.
        </p>
      </div>

      <div class="vscode-reference">
        <div>
          <h3 class="h3">Commands</h3>
          <table>
            <thead><tr><th>Command</th><th>Purpose</th></tr></thead>
            <tbody>
              <tr><td><code>h#: Show Generated Code</code></td><td>Open or reveal the generated-code preview panel.</td></tr>
            </tbody>
          </table>
        </div>
        <div>
          <h3 class="h3">Settings</h3>
          <table>
            <thead><tr><th>Setting</th><th>Default</th><th>Meaning</th></tr></thead>
            <tbody>
              <tr><td><code>hsharp.profilePath</code></td><td>empty</td><td>Profile JSON for diagnostics, highlighting, and preview.</td></tr>
              <tr><td><code>hsharp.entry</code></td><td>empty</td><td>Entry function; empty infers main or a single function.</td></tr>
              <tr><td><code>hsharp.debounceMs</code></td><td><code>120</code></td><td>Idle delay after the last edit, from 30 to 2000 ms.</td></tr>
              <tr><td><code>hsharp.diagnostics</code></td><td><code>true</code></td><td>Show compiler diagnostics.</td></tr>
              <tr><td><code>hsharp.previewTarget</code></td><td><code>csharp</code></td><td>Target selected when the preview opens.</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <section class="section band-dark">
    <div class="container">
      <div class="section-head">
        <div>
          <h2 class="h2">What is not there yet.</h2>
        </div>
        <p class="lede">
          The extension is deliberately small. The missing features are explicit so the current
          surface stays predictable.
        </p>
      </div>
      <ul class="vscode-limits">
        <li><strong>Not a web extension.</strong> It runs in the desktop workspace extension host.</li>
        <li><strong>No completion or navigation.</strong> No go-to-definition, rename, code actions, or debugging yet.</li>
        <li><strong>Read-only preview.</strong> Generated code is displayed, not edited in place.</li>
        <li><strong>No in-editor build/run.</strong> Use the CLI in a terminal for native execution.</li>
        <li><strong>Whole-document analysis.</strong> Each edit reparses the file; it is fast for normal files, but not incremental.</li>
        <li><strong>Haskell uses .hs too.</strong> If another extension claims the file, use the language mode picker and select h#.</li>
      </ul>
      <div class="row" style="margin-top:1.4rem;">
        <a class="btn btn-lime" href="/docs/getting-started">Read the setup guide</a>
        <a class="btn btn-ghost" href={repo}>Browse the extension</a>
      </div>
    </div>
  </section>
</BaseLayout>
