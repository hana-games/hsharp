---
import { nav, site } from "../lib/site";
import GitHubIcon from "./GitHubIcon.astro";

interface Props {
  active?: string;
}
const { active = "" } = Astro.props;
const pathname = Astro.url.pathname;
const current = pathname.startsWith("/fr") ? "fr" : pathname.startsWith("/ja") ? "ja" : "en";
---

<header class="site-header">
  <div class="container site-header-inner">
    <a class="brand" href="/" aria-label="h# home">h<span>#</span></a>

    <nav class="nav-links" aria-label="Primary">
      {
        nav.map((item) => (
          <a
            class:list={["nav-link", { active: active === item.href }]}
            href={item.href}
          >
            {item.label}
          </a>
        ))
      }
      <div class="lang-switch" aria-label="Language">
        <a data-locale="en" class:list={["lang-link", { active: current === "en" }]} href="/">EN</a>
        <a data-locale="fr" class:list={["lang-link", { active: current === "fr" }]} href="/fr/">FR</a>
        <a data-locale="ja" class:list={["lang-link", { active: current === "ja" }]} href="/ja/">日本語</a>
      </div>
      <a class="github-link" href={site.github} target="_blank" rel="noreferrer" aria-label="Source on GitHub" title="Clone the repository">
        <GitHubIcon size={16} />
        <span>GitHub</span>
      </a>
      <a class="btn btn-solid btn-sm nav-cta" href="/docs/getting-started">
        Get started
      </a>
    </nav>

    <details class="mobile-nav">
      <summary aria-label="Open navigation">Menu</summary>
      <div class="mobile-nav-panel">
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        <div class="mobile-langs">
          <a data-locale="en" href="/">EN</a>
          <a data-locale="fr" href="/fr/">FR</a>
          <a data-locale="ja" href="/ja/">日本語</a>
        </div>
        <a class="mobile-github" href={site.github} target="_blank" rel="noreferrer">
          <GitHubIcon size={15} />
          GitHub
        </a>
        <a href="/docs/getting-started"><strong>Get started</strong></a>
      </div>
    </details>
  </div>
</header>
