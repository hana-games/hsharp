{
  "h# function": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:x}: i32) -> i32 {",
      "    return ${3:0};",
      "}"
    ],
    "description": "h# function"
  },
  "h# immutable local": {
    "prefix": "let",
    "body": [
      "let ${1:name}: ${2:i32} = ${3:0};"
    ],
    "description": "h# immutable local binding"
  },
  "h# if": {
    "prefix": "if",
    "body": [
      "if ${1:condition} {",
      "    ${2:return 1;}",
      "}"
    ],
    "description": "h# conditional"
  },
  "h# if/else": {
    "prefix": "ife",
    "body": [
      "if ${1:condition} {",
      "    ${2:return 1;}",
      "} else {",
      "    ${3:return 0;}",
      "}"
    ],
    "description": "h# conditional with else"
  }
}
